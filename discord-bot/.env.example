# Token del Bot de Discord (obtenido en https://discord.com/developers/applications)
DISCORD_TOKEN=tu_token_aqui

# ID de tu Servidor de Discord (clic derecho en el icono de tu servidor > Copiar ID)
GUILD_ID=tu_guild_id_aqui

# ID del Canal de Voz donde el bot va a transmitir (clic derecho en el canal de voz > Copiar ID)
VOICE_CHANNEL_ID=tu_canal_de_voz_id_aqui

# URL del flujo de streaming en vivo de Radio Nexo
STREAM_URL=https://nexo-radio-bridge-axxt.onrender.com/live
